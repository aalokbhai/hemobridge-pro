# Is file ko copy karke ".env" naam se save karo, phir apni values bharo.
# (.env ko kabhi GitHub / zip me share mat karo)

# --- Server ---
NODE_ENV=production
PORT=3000
# Nginx ke peeche chala rahe ho to 1 rakho (sahi IP + https pata chalta hai)
TRUST_PROXY=1
# https certificate lagne ke baad true karo (http -> https redirect)
FORCE_HTTPS=false

# --- Pehla admin (sirf pehli baar server chalne par ban-ta hai) ---
# Password kam se kam 10 characters ka ho, "admin123" mat rakhna
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisStrongPassword

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=hemo
DB_PASSWORD=
DB_NAME=hemobridge
# Cloud MySQL (PlanetScale / Aiven / RDS) ke liye true karo
DB_SSL=false

# --- Docker Compose use karne par (docker-compose.yml me chahiye) ---
DB_ROOT_PASSWORD=

# --- Subscription rules ---
# Plan khatam hone ke baad kitne din access chalta rahe
GRACE_DAYS=3
# Ek hospital ek din me kitne donors ka phone number dekh sakta hai
PHONE_REVEAL_DAILY_LIMIT=50
# Login kitne ghante tak chalu rahe
SESSION_HOURS=12

# --- Hospital ko payment kahan karni hai (manual payment flow) ---
PAY_PAYEE_NAME=HemoBridge
PAY_UPI_ID=yourname@upi
PAY_BANK_DETAILS=A/C 0000000000, IFSC XXXX0000000, Your Bank
PAY_NOTE=Payment ke baad neeche transaction reference (UTR) daalo. Plan kuch ghanton me chalu ho jaata hai.
